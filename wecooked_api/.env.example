# Copy this file to .env and fill in real values. .env is git-ignored.

# Roboflow inference API key (required).
# Get it from https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your-roboflow-api-key-here

# Optional overrides
# ROBOFLOW_API_URL=https://serverless.roboflow.com
# PORT=5000
# HOST=127.0.0.1        # set to 0.0.0.0 to expose on your LAN (trusted networks only)
# FLASK_DEBUG=false     # never enable in a deployment
